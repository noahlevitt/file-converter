# ---------------------------------------------------------------------------
# Settings for the file converter. Copy to .env and fill in. Never commit the real .env.
#
#   cp .env.example .env
#
# Read by: run_local.sh / run_local.bat (the app loads .env itself) and docker-compose.yml (env_file: .env).
# Real environment variables win over values in .env. Restart the app after changing anything here.
# Write each setting as KEY=value on its own line; comments must be on their own line (starting with #),
# not after a value. Full descriptions: README → "Settings (.env)" and converter/config.py.
# ---------------------------------------------------------------------------

# ----- Claude (optional) ----------------------------------------------------
# Claude API key (optional) from https://platform.claude.com — leave empty to run without Claude; everything else works
ANTHROPIC_API_KEY=

# Models (defaults shown)
# MAPPING_MODEL: column matching, Apply notes and Check for mistakes. REPAIR_MODEL: Suggest fixes (value repairs).
MAPPING_MODEL=claude-sonnet-5-5
REPAIR_MODEL=claude-haiku-5-5
# Sample values per column sent to Claude when mapping (headers + these samples only; never the whole file)
AI_SAMPLE_VALUES=15
# false = never call Claude, even when an API key is set (Apply notes is disabled, Suggest fixes is hidden,
# Check for mistakes runs the rule checks only).
AI_ENABLED=true
# Claude is only called when someone clicks Apply notes / Check for mistakes / Suggest fixes.
# true = also let Claude refine column matching automatically on every upload.
AI_AUTO_MAP=false
# Partly mask phone digits in rows sent for Claude's mistake check
AI_MASK_PHONES=true

# ----- Logins ---------------------------------------------------------------
# First admin account, created automatically on first start if no users exist.
# Remove ADMIN_PASSWORD from this file after the first sign-in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# password (default) or none (no login — only for a single person on their own computer)
AUTH_MODE=password

# ----- App ------------------------------------------------------------------
# Browser tab title and login heading.
APP_TITLE=Import File Converter
# Time zone for times shown in the app
APP_TIMEZONE=America/New_York
# Page that opens first: new (upload) or imports (tracker)
DEFAULT_PAGE=new

# ----- Imports --------------------------------------------------------------
# Imports that can run at the same time (more queue and wait)
IMPORT_WORKERS=2
# Days to keep each import's files (original, converted, rejected rows, comparison data). 0 = keep forever.
# The import record and its counts are always kept.
FILE_RETENTION_DAYS=30

# ----- Paths ----------------------------------------------------------------
# Paths (defaults are fine for Docker)
# SCHEMA_PATH: the target import format. DATA_DIR: database (converter.db) and each import's files.
# Without Docker the defaults are schemas/target_schema.yaml and data/ inside the project folder.
# SCHEMA_PATH=/app/schemas/target_schema.yaml
# DATA_DIR=/app/data
